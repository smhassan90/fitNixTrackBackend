// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // Vercel/Linux runtimes vary; include common OpenSSL 3 engines so the query engine is present at cold start.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GymTenantStatus {
  ACTIVE
  SUSPENDED
}

model Gym {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String?          @unique
  logoUrl        String?          @db.VarChar(2048)
  address        String?
  city           String?
  country        String?
  phone          String?
  email          String?
  admissionFee          Float?           @default(0) // Admission fee configured in settings
  maxMemberDiscount     Float?           @default(100) // Max flat discount (PKR) allowed per member in settings
  autoCheckoutHours     Int              @default(6) // Auto sign-out if no checkout after N hours
  absenceInactiveDays   Int?             // Mark member inactive after N days without check-in (null = disabled)
  syncApiKey            String?          @unique @db.VarChar(128) // Permanent per-gym tablet sync key (no expiry)
  timezone              String           @default("UTC") @db.VarChar(64) // IANA zone for billing/attendance calendar
  /// Brand colors for portal/mobile: { ink, surface, primary, primaryDark, canvas }. Null → defaults.
  theme                 Json?
  tenantStatus   GymTenantStatus  @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  users                     User[]
  members                   Member[]
  trainers                  Trainer[]
  employees                 Employee[]
  packages                  Package[]
  payments                  Payment[]
  attendanceRecords         AttendanceRecord[]
  employeeAttendanceRecords EmployeeAttendanceRecord[]
  deviceConfigs             DeviceConfig[]
  oneTimePayments           OneTimePayment[]
  feeCollections            FeeCollection[]
  gymSubscription           GymSubscription?
  billingPayments           BillingPayment[]
  pendingAttendanceLogs     PendingAttendanceLog[]
  gymPosSubcategories       GymPosSubcategory[]
  posProducts               PosProduct[]
  posStockMovements         PosStockMovement[]
  posSales                  PosSale[]
  workoutLogs               WorkoutLog[]
  mobileOrders              MobileOrder[]
  mobileOtpSessions         MobileOtpSession[]
  mobileNotifications       MobileNotification[]
  mobilePushTokens          MobilePushToken[]
  marketingProfile          MarketingProfile?
  marketingSocialAccounts   MarketingSocialAccount[]
  marketingOpportunities    MarketingContentOpportunity[]
  marketingContents         MarketingContent[]
  marketingAiUsage          MarketingAiUsage[]
  marketingPublishAttempts  MarketingPublishAttempt[]

  @@map("gyms")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  @unique @db.VarChar(10)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cities City[]

  @@index([isActive, sortOrder, name])
  @@map("countries")
}

model City {
  id        Int      @id @default(autoincrement())
  countryId Int
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name])
  @@index([isActive, sortOrder, name])
  @@index([countryId])
  @@map("cities")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String
  password     String
  phone        String?
  role         UserRole  @default(STAFF)
  /// Explicit gym feature permissions. Null preserves legacy role defaults; [] means no optional permissions.
  permissionKeys Json?
  gymId        Int
  gymName      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, email])
  @@index([gymId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  GYM_ADMIN
  GYM_MANAGER
  GYM_STAFF
  STAFF
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_SUPPORT
}

enum GymSubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  CANCELLED
}

model Plan {
  id           Int       @id @default(autoincrement())
  name         String
  code         String?   @unique @db.VarChar(64)
  description  String?   @db.Text
  /// Monthly base price (PKR). Payable for longer cycles is computed via planPricing helper.
  price        Float
  currency     String    @default("PKR") @db.VarChar(10)
  /// Base price period for this tier row (always MONTHLY for platform subscription tiers).
  billingCycle String    @default("MONTHLY") @db.VarChar(32)
  /// Hard cap on active members for gyms on this plan.
  maxMembers   Int?
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  features     Json?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  gymSubscriptions GymSubscription[]

  @@index([isActive, sortOrder, name])
  @@map("plans")
}

model BillingPayment {
  id         Int      @id @default(autoincrement())
  gymId      Int
  amountPaid Float
  currency   String   @db.VarChar(10)
  paidAt     DateTime @db.Date
  method     String   @db.VarChar(32)
  notes      String?  @db.Text
  status     String   @default("PAID") @db.VarChar(16)
  receiptNo  String   @unique @db.VarChar(64)
  createdBy  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([paidAt])
  @@map("billing_payments")
}

model GymSubscription {
  id                Int                   @id @default(autoincrement())
  gymId             Int                   @unique
  planId            Int
  dueDate           DateTime              @db.Date
  /// Selected prepaid cycle for this gym: MONTHLY | BIANNUAL | ANNUAL
  billingCycle      String                @default("MONTHLY") @db.VarChar(32)
  billingResumeFrom DateTime?
  status            GymSubscriptionStatus @default(ACTIVE)
  lastPaidAt        DateTime?
  notes             String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([dueDate])
  @@map("gym_subscriptions")
}

model PlatformUser {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  password       String
  role           PlatformRole @default(PLATFORM_SUPPORT)
  isActive       Boolean      @default(true)
  permissionKeys Json?
  tokenVersion   Int          @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int
  actorRole   String   @db.VarChar(32)
  actionType  String   @db.VarChar(64)
  targetGymId Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor PlatformUser @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetGymId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

enum MobileAccountType {
  MEMBER
  TRAINER
}

enum WorkoutBodyPart {
  CHEST
  BICEPS
  TRICEPS
  BACK
  SHOULDERS
  TRAPS
  LEGS
  ABS
  CARDIO
  AEROBICS
  YOGA
  FULL_BODY
}

enum MobileOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MobileNotificationType {
  PAYMENT_OVERDUE
  PAYMENT_DUE_SOON
  ORDER_READY
  ORDER_COMPLETED
  GENERAL
}

model Member {
  id                    Int       @id @default(autoincrement())
  gymId                 Int
  /// Gym-facing member number (unique per gym). Display this — never expose `id` as Member ID.
  legacyMemberId        String?   @db.VarChar(64)
  name                  String
  phone                 String?
  email                 String?
  gender                String?
  dateOfBirth           DateTime?
  cnic                  String?   @db.VarChar(13)
  comments              String?   @db.Text
  /// Compressed member portrait URL (Vercel Blob or `/uploads/members/...`). Kept ~50KB.
  photoUrl              String?   @db.VarChar(2048)
  /// Standing height in centimeters (once / editable). Not monthly.
  heightCm              Float?
  packageId             Int?
  discount              Float?
  membershipStart       DateTime?
  membershipEnd         DateTime?
  isActive              Boolean   @default(true)
  inactiveFrom          DateTime?
  billingResumeFrom     DateTime?
  admissionFeeWaived    Boolean   @default(false) // Whether admission fee was waived
  admissionFeePaid      Float?    @default(0) // Actual admission fee paid (0 if waived)
  oneTimePaymentAmount  Float?    // Total one-time payment (admission + package + trainer fees)
  oneTimePaymentPaid    Boolean   @default(false) // Whether one-time payment was completed
  monthlyPaymentAmount  Float?    // Monthly recurring payment amount (for income calculation)
  mobileTokenVersion    Int       @default(0)
  mobileLastLoginAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  gym                Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  package            Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  trainers           MemberTrainer[]
  payments           Payment[]
  attendanceRecords  AttendanceRecord[]
  deviceUserMappings DeviceUserMapping[]
  oneTimePayments    OneTimePayment[]
  feeCollections     FeeCollection[]
  posSales           PosSale[]
  workoutLogs        WorkoutLog[]
  mobileOrders       MobileOrder[]
  mobileNotifications MobileNotification[]
  mobilePushTokens   MobilePushToken[]
  bodyMeasurements   MemberBodyMeasurement[]

  @@index([gymId])
  @@index([packageId])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@index([cnic])
  @@index([gymId, createdAt])
  @@unique([gymId, legacyMemberId])
  @@index([gymId, legacyMemberId])
  @@map("members")
}

/// Monthly body measurements for mobile progress tracking (per member, YYYY-MM).
model MemberBodyMeasurement {
  id        Int      @id @default(autoincrement())
  memberId  Int
  /// Calendar month key, e.g. "2026-07"
  month     String   @db.Char(7)
  weightKg  Float?
  armsCm    Float?
  thighsCm  Float?
  chestCm   Float?
  waistCm   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, month])
  @@index([memberId, month])
  @@map("member_body_measurements")
}

model Trainer {
  id             Int       @id @default(autoincrement())
  gymId          Int
  name           String
  phone          String?   @db.VarChar(40)
  /// Normalized (trim + lower). Unique per gym when set — same email may exist at other gyms.
  email          String?   @db.VarChar(191)
  gender         String?
  dateOfBirth    DateTime?
  specialization String?   @db.Text
  charges        Float?
  startTime      String?   @db.VarChar(5) // HH:mm format
  endTime        String?   @db.VarChar(5) // HH:mm format
  isActive             Boolean   @default(true)
  mobileTokenVersion   Int       @default(0)
  mobileLastLoginAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  gym                  Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members              MemberTrainer[]
  workoutLogs          WorkoutLog[]    @relation("TrainerWorkoutLogs")
  loggedWorkouts       WorkoutLog[]    @relation("WorkoutLoggedByTrainer")
  mobileOrders         MobileOrder[]
  mobileNotifications  MobileNotification[]
  mobilePushTokens     MobilePushToken[]

  @@unique([gymId, email])
  @@index([gymId])
  @@index([email])
  @@index([gymId, phone])
  @@index([gymId, isActive])
  @@map("trainers")
}

model Package {
  id        Int      @id @default(autoincrement())
  gymId     Int
  name      String
  price     Float
  discount  Float?   @default(0) // Discount amount (optional, defaults to 0)
  duration  String // '1 month', '3 months', '6 months', '12 months'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members  Member[]
  features PackageFeature[]

  @@index([gymId])
  @@map("packages")
}

model Feature {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String?   @unique @db.VarChar(64)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages PackageFeature[]

  @@index([isActive, sortOrder, name])
  @@map("features")
}

model PackageFeature {
  packageId Int
  featureId Int
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([packageId, featureId])
  @@index([packageId])
  @@index([featureId])
  @@map("package_features")
}

model Payment {
  id        Int           @id @default(autoincrement())
  gymId     Int
  memberId  Int
  month     String        @db.VarChar(7) // Format: 'YYYY-MM'
  amount    Float
  status    PaymentStatus @default(PENDING)
  dueDate   DateTime
  paidDate  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model OneTimePayment {
  id                Int       @id @default(autoincrement())
  gymId             Int
  memberId          Int
  admissionFee      Float     @default(0) // Admission fee amount
  packageFee        Float     @default(0) // Package fee (after discount)
  trainerFee        Float     @default(0) // Total trainer fees
  totalAmount       Float     // Total one-time payment
  status            PaymentStatus @default(PENDING)
  paidDate          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([status])
  @@map("one_time_payments")
}

enum FeeCollectionSourceType {
  MONTHLY_PAYMENT
  ONE_TIME_PAYMENT
}

enum FeeCollectionCategory {
  MONTHLY_FEE
  SIGNUP_FEE
  ADMISSION_ONLY
}

model FeeCollection {
  id           Int                     @id @default(autoincrement())
  gymId        Int
  memberId     Int
  amount       Float
  collectedAt  DateTime
  billingMonth String?                 @db.VarChar(7)
  category     FeeCollectionCategory
  description  String                  @db.VarChar(255)
  sourceType   FeeCollectionSourceType
  sourceId     Int
  createdAt    DateTime                @default(now())

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([gymId])
  @@index([memberId])
  @@index([gymId, collectedAt])
  @@index([gymId, billingMonth])
  @@map("fee_collections")
}

model AttendanceRecord {
  id                 Int              @id @default(autoincrement())
  gymId              Int
  memberId           Int
  date               DateTime         @db.Date // Date only (no time)
  status             AttendanceStatus @default(PRESENT)
  checkInTime        DateTime? // Check-in timestamp from device
  checkOutTime       DateTime? // Check-out timestamp from device
  deviceUserId       String? // User ID from ZKTeco device
  deviceSerialNumber String? // Device serial number
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([gymId, memberId, date])
  @@index([gymId])
  @@index([memberId])
  @@index([date])
  @@index([deviceUserId])
  @@index([checkInTime])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

/// Gym staff / workers (reception, cleaning, security, etc.) — separate from members and trainers.
model Employee {
  id             Int       @id @default(autoincrement())
  gymId          Int
  /// Gym-visible employee code (e.g. EMP-001). Unique per gym when set.
  employeeNumber String?   @db.VarChar(64)
  name           String
  phone          String?   @db.VarChar(40)
  email          String?   @db.VarChar(191)
  gender         String?
  dateOfBirth    DateTime? @db.Date
  /// Job title / designation (e.g. Receptionist, Cleaner, Security)
  designation    String?   @db.VarChar(128)
  department     String?   @db.VarChar(128)
  dateOfJoining  DateTime? @db.Date
  salary         Float?
  notes          String?   @db.Text
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gym               Gym                        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  attendanceRecords EmployeeAttendanceRecord[]

  @@unique([gymId, employeeNumber])
  @@unique([gymId, email])
  @@index([gymId])
  @@index([gymId, isActive])
  @@index([gymId, phone])
  @@map("employees")
}

/// Daily attendance for gym employees — fully separate from member attendance_records.
model EmployeeAttendanceRecord {
  id           Int              @id @default(autoincrement())
  gymId        Int
  employeeId   Int
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String?          @db.VarChar(500)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([gymId, employeeId, date])
  @@index([gymId])
  @@index([employeeId])
  @@index([date])
  @@index([gymId, date])
  @@index([checkInTime])
  @@map("employee_attendance_records")
}

model MemberTrainer {
  memberId  Int
  trainerId Int
  createdAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([memberId, trainerId])
  @@index([memberId])
  @@index([trainerId])
  @@map("member_trainers")
}

model DeviceConfig {
  id             Int       @id @default(autoincrement())
  gymId          Int
  name           String // Device name/identifier
  ipAddress      String // Device IP address
  port           Int       @default(4370) // Default ZKTeco port
  serialNumber   String? // Device serial number
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime? // Last successful sync timestamp
  syncInterval   Int       @default(300) // Sync interval in seconds (5 minutes default)
  deviceUserId   String? // Admin user ID on device (optional)
  devicePassword String? // Admin password on device (optional)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gym                   Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userMappings          DeviceUserMapping[]
  deviceUsers           DeviceUser[]
  pendingAttendanceLogs PendingAttendanceLog[]

  @@unique([gymId, ipAddress, port])
  @@index([gymId])
  @@index([isActive])
  @@map("device_configs")
}

/// Users enrolled on a biometric device (may be unmapped to members).
model DeviceUser {
  id             Int      @id @default(autoincrement())
  deviceConfigId Int
  deviceUserId   String // User ID / uid on the ZKTeco device
  deviceUserName String?
  deviceBadgeId  String? // Badge / userId field from device
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deviceConfig DeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId])
  @@index([deviceConfigId])
  @@index([deviceUserName])
  @@map("device_users")
}

/// Attendance punches for device users not yet mapped to members.
model PendingAttendanceLog {
  id                 Int      @id @default(autoincrement())
  gymId              Int
  deviceConfigId     Int
  deviceUserId       String
  recordTime         DateTime
  type               Int?
  state              Int?
  deviceSerialNumber String?
  createdAt          DateTime @default(now())

  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  deviceConfig DeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId, recordTime], map: "pal_cfg_user_time_uniq")
  @@index([gymId], map: "pal_gymId_idx")
  @@index([deviceConfigId, deviceUserId], map: "pal_cfg_user_idx")
  @@map("pending_attendance_logs")
}

model DeviceUserMapping {
  id             Int      @id @default(autoincrement())
  deviceConfigId Int
  memberId       Int
  deviceUserId   String // User ID on the ZKTeco device
  deviceUserName String? // Name on the device
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deviceConfig DeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId])
  @@unique([deviceConfigId, memberId])
  @@index([deviceConfigId])
  @@index([memberId])
  @@index([deviceUserId])
  @@map("device_user_mappings")
}

// ─── Point of Sale (POS) ───────────────────────────────────────────────────

enum PosProductType {
  NUTRIENT
  ACCESSORY
}

enum PosProductForm {
  PACKAGED
  SERVING
}

enum PosStockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

enum PosSaleStatus {
  COMPLETED
  VOIDED
}

enum PosDiscountType {
  NONE
  PERCENT
  FLAT
}

model PosCategory {
  id          Int            @id @default(autoincrement())
  productType PosProductType
  name        String         @db.VarChar(128)
  code        String?        @unique @db.VarChar(64)
  description String?        @db.Text
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subcategories PosSubcategory[]

  @@unique([productType, name])
  @@index([productType, isActive, sortOrder])
  @@map("pos_categories")
}

model PosSubcategory {
  id           Int       @id @default(autoincrement())
  categoryId   Int
  name         String    @db.VarChar(128)
  code         String?   @unique @db.VarChar(64)
  description  String?   @db.Text
  /// JSON array of allowed forms for NUTRIENT subcategories, e.g. ["PACKAGED","SERVING"]
  allowedForms Json?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category   PosCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  gymEnabled GymPosSubcategory[]
  products   PosProduct[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive, sortOrder])
  @@map("pos_subcategories")
}

model GymPosSubcategory {
  gymId         Int
  subcategoryId Int
  enabledAt     DateTime @default(now())

  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subcategory PosSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@id([gymId, subcategoryId])
  @@index([subcategoryId])
  @@map("gym_pos_subcategories")
}

model PosProduct {
  id                Int              @id @default(autoincrement())
  gymId             Int
  subcategoryId     Int
  productType       PosProductType
  form              PosProductForm   @default(PACKAGED)
  name              String           @db.VarChar(255)
  sku               String?          @db.VarChar(64)
  description       String?          @db.Text
  /// Denormalized featured image URL (kept in sync with PosProductImage where isFeatured=true).
  imageUrl          String?          @db.VarChar(2048)
  brand             String?          @db.VarChar(128)
  price             Float
  discountType      PosDiscountType  @default(NONE)
  discountValue     Float            @default(0)
  calories          Float?
  proteinG          Float?
  carbsG            Float?
  fatG              Float?
  fiberG            Float?
  sugarG            Float?
  servingSizeG      Float?
  servingLabel      String?          @db.VarChar(64)
  material          String?          @db.VarChar(128)
  color             String?          @db.VarChar(64)
  size              String?          @db.VarChar(64)
  trackInventory    Boolean          @default(true)
  stockQuantity     Int              @default(0)
  lowStockThreshold Int              @default(5)
  isActive          Boolean          @default(true)
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  gym            Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subcategory    PosSubcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  stockMovements PosStockMovement[]
  saleItems      PosSaleItem[]
  images         PosProductImage[]

  @@unique([gymId, sku])
  @@index([gymId, subcategoryId, isActive])
  @@index([gymId, productType])
  @@map("pos_products")
}

/// Gallery images for a POS product. Max 5 per product enforced in application code.
/// Exactly one should be featured when any images exist (synced to PosProduct.imageUrl).
model PosProductImage {
  id         Int      @id @default(autoincrement())
  gymId      Int
  productId  Int
  url        String   @db.VarChar(2048)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isFeatured])
  @@index([gymId])
  @@map("pos_product_images")
}

model PosStockMovement {
  id          Int                  @id @default(autoincrement())
  gymId       Int
  productId   Int
  type        PosStockMovementType
  quantity    Int
  stockAfter  Int
  note        String?              @db.Text
  saleId      Int?
  createdById Int
  createdAt   DateTime             @default(now())

  gym     Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  product PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale    PosSale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([gymId, productId])
  @@index([gymId, createdAt])
  @@index([saleId])
  @@map("pos_stock_movements")
}

model PosSale {
  id            Int           @id @default(autoincrement())
  gymId         Int
  receiptNo     String        @unique @db.VarChar(64)
  status        PosSaleStatus @default(COMPLETED)
  subtotal      Float
  discountTotal Float         @default(0)
  total         Float
  memberId      Int?
  soldById      Int
  notes         String?       @db.Text
  soldAt        DateTime      @default(now())
  voidedAt      DateTime?
  voidedById    Int?
  voidReason    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  gym            Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member         Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  items          PosSaleItem[]
  stockMovements PosStockMovement[]

  @@index([gymId, soldAt])
  @@index([gymId, status])
  @@index([memberId])
  @@map("pos_sales")
}

model PosSaleItem {
  id              Int              @id @default(autoincrement())
  saleId          Int
  productId       Int
  productName     String           @db.VarChar(255)
  productType     PosProductType
  categoryId      Int
  categoryName    String           @db.VarChar(128)
  subcategoryId   Int
  subcategoryName String           @db.VarChar(128)
  form            PosProductForm
  quantity        Int
  unitPrice       Float
  discountType    PosDiscountType  @default(NONE)
  discountValue   Float            @default(0)
  lineSubtotal    Float
  lineDiscount    Float            @default(0)
  lineTotal       Float

  sale    PosSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product PosProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([subcategoryId])
  @@index([categoryId])
  @@map("pos_sale_items")
}

// ─── Mobile App ────────────────────────────────────────────────────────────

model WorkoutLog {
  id                 Int               @id @default(autoincrement())
  gymId              Int
  /// Subject of the workout — member or trainer logging for themselves.
  accountType        MobileAccountType
  memberId           Int?
  trainerId          Int?
  /// Who created the log (member self, or trainer on behalf of member/trainer).
  loggedByType       MobileAccountType
  loggedByMemberId   Int?
  loggedByTrainerId  Int?
  date               DateTime          @db.Date
  bodyParts          Json              // WorkoutBodyPart[] e.g. ["CHEST","LEGS"]
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  gym               Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member            Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer           Trainer? @relation("TrainerWorkoutLogs", fields: [trainerId], references: [id], onDelete: Cascade)
  loggedByTrainer   Trainer? @relation("WorkoutLoggedByTrainer", fields: [loggedByTrainerId], references: [id], onDelete: SetNull)

  @@unique([gymId, memberId, date], map: "workout_member_day_uniq")
  @@unique([gymId, trainerId, date], map: "workout_trainer_day_uniq")
  @@index([gymId, date])
  @@index([memberId, date])
  @@index([trainerId, date])
  @@map("workout_logs")
}

model MobileOrder {
  id              Int               @id @default(autoincrement())
  gymId           Int
  orderNo         String            @unique @db.VarChar(64)
  status          MobileOrderStatus @default(PENDING)
  placedByType    MobileAccountType
  memberId        Int?
  trainerId       Int?
  subtotal        Float
  total           Float
  notes           String?           @db.Text
  posSaleId       Int?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  gym     Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  trainer Trainer?          @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  items   MobileOrderItem[]

  @@index([gymId, status])
  @@index([memberId])
  @@index([trainerId])
  @@index([gymId, createdAt])
  @@map("mobile_orders")
}

model MobileOrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  productName  String  @db.VarChar(255)
  productType  PosProductType
  quantity     Int
  unitPrice    Float
  lineTotal    Float
  calories     Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?

  order MobileOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("mobile_order_items")
}

model MobileOtpSession {
  id        Int      @id @default(autoincrement())
  gymId     Int
  phone     String   @db.VarChar(40)
  otpHash   String   @db.VarChar(128)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, phone])
  @@index([expiresAt])
  @@map("mobile_otp_sessions")
}

model MobileNotification {
  id          Int                    @id @default(autoincrement())
  gymId       Int
  accountType MobileAccountType
  memberId    Int?
  trainerId   Int?
  type        MobileNotificationType
  title       String                 @db.VarChar(255)
  body        String                 @db.Text
  metadata    Json?
  isRead      Boolean                @default(false)
  createdAt   DateTime               @default(now())

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([gymId, memberId, isRead])
  @@index([gymId, trainerId, isRead])
  @@index([createdAt])
  @@map("mobile_notifications")
}

model MobilePushToken {
  id          Int               @id @default(autoincrement())
  gymId       Int
  accountType MobileAccountType
  memberId    Int?
  trainerId   Int?
  deviceToken String            @db.VarChar(512)
  platform    String            @db.VarChar(16) // ios | android
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  gym     Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([gymId, accountType, memberId, trainerId, deviceToken], map: "mobile_push_tokens_uniq")
  @@index([memberId])
  @@index([trainerId])
  @@map("mobile_push_tokens")
}

/// Google-authenticated personal users (not linked to a gym member profile).
model MobileGoogleUser {
  id           Int       @id @default(autoincrement())
  googleSub    String    @unique @db.VarChar(128)
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(191)
  photoUrl     String?   @db.VarChar(2048)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workouts GuestWorkoutLog[]

  @@index([email])
  @@map("mobile_google_users")
}

/// Short-lived PKCE sessions for mobile Google OAuth (Play Store–safe browser flow).
model MobileOAuthSession {
  sessionId    String   @id @db.VarChar(36)
  state        String   @unique @db.VarChar(128)
  codeVerifier String   @db.VarChar(128)
  idToken      String?  @db.Text
  expiresAt    DateTime
  used         Boolean  @default(false)
  platform     String?  @db.VarChar(32)
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("mobile_oauth_sessions")
}

/// Personal gym-activity logs for Google guests (no gym association).
model GuestWorkoutLog {
  id           Int      @id @default(autoincrement())
  googleUserId Int
  date         DateTime @db.Date
  bodyParts    Json
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  googleUser MobileGoogleUser @relation(fields: [googleUserId], references: [id], onDelete: Cascade)

  @@unique([googleUserId, date], map: "guest_workout_day_uniq")
  @@index([googleUserId, date])
  @@map("guest_workout_logs")
}

enum AccountDeletionStatus {
  pending
  in_progress
  completed
  rejected
  cancelled
}

enum AccountDeletionAccountType {
  member
  trainer
  other
}

enum AccountDeletionSource {
  web
  app
}

// ---------------------------------------------------------------------------
// Marketing module (Phase 1 foundation)
// ---------------------------------------------------------------------------

enum MarketingSocialAccountStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  PENDING
}

enum MarketingOpportunityStatus {
  DRAFT
  AWAITING_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum MarketingContentStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

enum MarketingImageStatus {
  PENDING
  READY
  FAILED
}

enum MarketingPublishAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// 1:1 marketing profile per gym (seeded from Gym on first read).
model MarketingProfile {
  id                     Int      @id @default(autoincrement())
  gymId                  Int      @unique
  description            String?  @db.Text
  location               String?  @db.VarChar(255)
  city                   String?  @db.VarChar(120)
  country                String?  @db.VarChar(120)
  address                String?  @db.Text
  phone                  String?  @db.VarChar(40)
  website                String?  @db.VarChar(500)
  services               String?  @db.Text
  membershipPackages     String?  @db.Text
  targetAudience         String?  @db.Text
  uniqueSellingPoints    String?  @db.Text
  facilities             String?  @db.Text
  trainers               String?  @db.Text
  promotions             String?  @db.Text
  brandTone              String?  @db.VarChar(255)
  preferredLanguage      String?  @db.VarChar(64)
  keywords               String?  @db.Text
  seoTopics              String?  @db.Text
  doNotClaim             String?  @db.Text
  additionalInstructions String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@map("marketing_profiles")
}

/// Connected social / Google Business accounts (Phase 1: schema only).
model MarketingSocialAccount {
  id              Int                          @id @default(autoincrement())
  gymId           Int
  platform        String                       @db.VarChar(64)
  accountName     String?                      @db.VarChar(255)
  status          MarketingSocialAccountStatus @default(DISCONNECTED)
  accessTokenEnc  String?                      @db.Text
  refreshTokenEnc String?                      @db.Text
  tokenExpiresAt  DateTime?
  connectedAt     DateTime?
  lastPublishAt   DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, platform])
  @@map("marketing_social_accounts")
}

/// Content opportunity ideas awaiting review / conversion.
model MarketingContentOpportunity {
  id                Int                        @id @default(autoincrement())
  gymId             Int
  title             String                     @db.VarChar(255)
  reason            String?                    @db.Text
  audience          String?                    @db.Text
  contentType       String?                    @db.VarChar(64)
  suggestedPlatform String?                    @db.VarChar(64)
  seoIntent         String?                    @db.Text
  priority          Int                        @default(0)
  keywords          String?                    @db.Text
  status            MarketingOpportunityStatus @default(DRAFT)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  gym      Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  contents MarketingContent[]

  @@index([gymId])
  @@index([gymId, status])
  @@map("marketing_content_opportunities")
}

/// Draft / approved marketing content items.
model MarketingContent {
  id                 Int                    @id @default(autoincrement())
  gymId              Int
  opportunityId      Int?
  contentKind        String                 @default("SOCIAL_POST") @db.VarChar(64)
  title              String                 @db.VarChar(255)
  status             MarketingContentStatus @default(DRAFT)
  topic              String?                @db.Text
  headline           String?                @db.VarChar(500)
  caption            String?                @db.Text
  captionShort       String?                @db.Text
  cta                String?                @db.VarChar(500)
  hashtags           String?                @db.Text
  imageConcept       String?                @db.Text
  imagePrompt        String?                @db.Text
  suggestedPlatforms Json?
  platformVariants   Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  gym             Gym                          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  opportunity     MarketingContentOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  imageVersions   MarketingImageVersion[]
  publishAttempts MarketingPublishAttempt[]

  @@index([gymId])
  @@index([gymId, status])
  @@index([gymId, contentKind])
  @@index([opportunityId])
  @@map("marketing_contents")
}

/// Image variants generated / attached to a content item.
model MarketingImageVersion {
  id             Int                  @id @default(autoincrement())
  contentId      Int
  prompt         String?              @db.Text
  modifiedPrompt String?              @db.Text
  imageUrl       String?              @db.VarChar(2048)
  status         MarketingImageStatus @default(PENDING)
  provider       String?              @db.VarChar(64)
  createdAt      DateTime             @default(now())

  content MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@map("marketing_image_versions")
}

/// Publish attempt stub for later scheduling / social publishing phases.
model MarketingPublishAttempt {
  id           Int                          @id @default(autoincrement())
  gymId        Int
  contentId    Int?
  platform     String?                      @db.VarChar(64)
  status       MarketingPublishAttemptStatus @default(PENDING)
  externalId   String?                      @db.VarChar(255)
  errorMessage String?                      @db.Text
  attemptedAt  DateTime                     @default(now())
  createdAt    DateTime                     @default(now())

  gym     Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  content MarketingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([contentId])
  @@map("marketing_publish_attempts")
}

/// AI usage metering (Phase 1: overview returns zeros until used).
model MarketingAiUsage {
  id             Int      @id @default(autoincrement())
  gymId          Int
  platformUserId Int?
  operationType  String   @db.VarChar(64)
  provider       String?  @db.VarChar(64)
  model          String?  @db.VarChar(128)
  tokens         Int?
  costUsd        Float?
  createdAt      DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@index([platformUserId])
  @@map("marketing_ai_usage")
}

/// Google Play–compliant account & data deletion requests (public web form + in-app).
model AccountDeletionRequest {
  id                     String                     @id @db.VarChar(40)
  fullName               String                     @db.VarChar(100)
  email                  String?                    @db.VarChar(191)
  phone                  String?                    @db.VarChar(40)
  accountType            AccountDeletionAccountType
  gymName                String?                    @db.VarChar(200)
  reason                 String?                    @db.Text
  source                 AccountDeletionSource      @default(web)
  status                 AccountDeletionStatus      @default(pending)
  matchedMemberId        Int?
  matchedTrainerId       Int?
  matchedGymId           Int?
  processedAt            DateTime?
  processedByPlatformUserId Int?
  processorNotes         String?                    @db.Text
  requesterIp            String?                    @db.VarChar(64)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@map("account_deletion_requests")
}
